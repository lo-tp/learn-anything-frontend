# Learn Anything — environment template.
# Copy to .env (which is gitignored) and fill in.

# Backend API — origin of the Clarify/session API (see types/api.d.ts and
# lib/api-client.ts). Must be NEXT_PUBLIC_-prefixed: the client reads it in
# the browser.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080

# Sandbox — origin of the sandbox server (serves /sandbox/* routes).
NEXT_PUBLIC_SANDBOX_ORIGIN=http://localhost:3001

# Auth — secret used by the middleware (proxy.ts) to verify sign-in JWT cookies.
# Generate your own (e.g. `openssl rand -hex 32`). Never commit the real value.
JWT_SECRET=
