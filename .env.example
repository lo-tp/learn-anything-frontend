# Learn Anything — environment template.
# Copy to .env (which is gitignored) and fill in.

# Dev Postgres — see docker-compose.yml (podman compose up -d, port 5434).
# scripts/setup-db.sh creates the actual databases inside it.
DATABASE_URL=postgresql://learn_anything:learn_anything@localhost:5434/learn_anything

# LLM — a user-managed, OpenAI-compatible server (e.g. local llama.cpp).
# The app only consumes this endpoint; it never starts or manages the server.
LLM_BASE_URL=http://localhost:8080/v1
LLM_API_KEY=llama.cpp
LLM_MODEL=

# Sandbox — origin of the sandbox server (serves /sandbox/* routes).
NEXT_PUBLIC_SANDBOX_ORIGIN=http://localhost:3001
