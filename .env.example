# Learn Anything — environment template.
# Copy to .env (which is gitignored) and fill in.

# Backend API — origin of the Clarify/session API (see types/api.d.ts and
# lib/api-client.ts). Must be NEXT_PUBLIC_-prefixed: the client reads it in
# the browser.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080

# Sandbox — origin of the sandbox server (serves /sandbox/* routes).
NEXT_PUBLIC_SANDBOX_ORIGIN=http://localhost:3001

# Dev-only — extra origins allowed to drive `next dev`, comma-separated hosts with
# no scheme or port (e.g. 192.168.31.178). Leave unset for ordinary localhost work:
# Next then allows only the host the server was started with. Set it when another
# device on your network opens the app, or the page loads but the client never
# boots. Read by `devAllowedOrigins` in next.config.ts, whose comment carries the
# symptom, the dev-log line it leaves, and the two ways to write it wrong.
# DEV_ALLOWED_ORIGINS=192.168.31.178
