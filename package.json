{
  "name": "learn-anything",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "generate:types": "openapi-typescript http://localhost:8001/openapi.json -o types/api.d.ts",
    "lint": "eslint",
