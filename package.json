    "lucide-react": "^1.38.0",
    "next": "16.3.4",
    "next-intl": "^4.14.5",
    "openapi-fetch": "^0.17.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.19.1",
    "tailwind-merge": "^3.6.0",
    "temml": "^0.13.5",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
